{
  "id": "/image/image-compressor.html",
  "name": "Image Compressor — 1234Tools",
  "short_name": "Image Compressor",
  "description": "Shrink JPEG, PNG, WebP and AVIF files with MozJPEG, libwebp and oxipng in your browser, with a before/after slider and a size limit mode.",
  "start_url": "/image/image-compressor/?src=pwa",
  "scope": "/image/image-compressor/",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "theme_color": "#06080f",
  "background_color": "#06080f",
  "lang": "en-GB",
  "dir": "ltr",
  "categories": [
    "photo",
    "utilities"
  ],
  "icons": [
    {
      "src": "/assets/pwa/i-image-compressor.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/assets/pwa/i-image-compressor-maskable.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "maskable"
    },
    {
      "src": "/assets/pwa/i-image-compressor-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "share_target": {
    "action": "/image/image-compressor/?share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "files",
          "accept": [
            "image/png",
            ".png",
            "image/jpeg",
            ".jpg",
            ".jpeg",
            "image/webp",
            ".webp",
            "image/gif",
            ".gif",
            "image/avif",
            ".avif",
            "image/bmp",
            ".bmp"
          ]
        }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "/image/image-compressor/",
      "accept": {
        "image/png": [
          ".png"
        ],
        "image/jpeg": [
          ".jpg",
          ".jpeg"
        ],
        "image/webp": [
          ".webp"
        ],
        "image/gif": [
          ".gif"
        ],
        "image/avif": [
          ".avif"
        ],
        "image/bmp": [
          ".bmp"
        ]
      }
    }
  ],
  "launch_handler": {
    "client_mode": [
      "navigate-existing",
      "auto"
    ]
  }
}
