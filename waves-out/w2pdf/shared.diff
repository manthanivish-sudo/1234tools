+.marks-remove .page-card.is-selected { border-color: #e05c4a; box-shadow: 0 0 0 1px #e05c4a inset; }
+.marks-remove .page-card.is-selected .page-check { background: #e05c4a; border-color: #e05c4a; color: #fff; }
